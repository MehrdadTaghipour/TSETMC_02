# ========================================================
# TSETMC Iranian Stock Market Environment Configuration
# ========================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# RELAY_URL: Optional Iranian IP Proxy URL.
# Required if deploying backend on a server located outside Iran (AWS, GCP, Hetzner, etc.)
# Example: "http://185.120.x.x:8080"
RELAY_URL=""
RELAY_SECRET_TOKEN=""

# TSETMC_UA: Realistic desktop browser User-Agent header to bypass immediate scraping block.
TSETMC_UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"

# POLL_INTERVAL_OPEN: Polling frequency in seconds during Tehran market hours (09:00 - 12:30). Default: 6
POLL_INTERVAL_OPEN=6

# POLL_INTERVAL_CLOSED: Polling frequency in seconds during market off-hours / weekends. Default: 60
POLL_INTERVAL_CLOSED=60

# CACHE_DIR: Persistent directory path for dual-tier disk cache storage
CACHE_DIR="/tmp/tsetmc_cache"

# LOG_LEVEL: Application logging verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# MOCK_MODE: Set to "true" to run with static verified recorded fixtures without calling TSETMC.
MOCK_MODE=false
